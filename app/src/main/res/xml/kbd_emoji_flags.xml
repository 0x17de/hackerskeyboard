        <Key app:codes="0x1F1FB,0x1F1F3" app:keyLabel="🇻🇳" />
        <Key app:codes="0x1F1F0,0x1F1EA" app:keyLabel="🇰🇪" />
        <Key app:codes="0x1F1E6,0x1F1EA" app:keyLabel="🇦🇪" />
        <Key app:codes="0x1F1F5,0x1F1F1" app:keyLabel="🇵🇱" />
        <Key app:codes="0x1F1E8,0x1F1ED" app:keyLabel="🇨🇭" />
        <Key app:codes="0x1F1E8,0x1F1FF" app:keyLabel="🇨🇿" />
        <Key app:codes="0x1F1E9,0x1F1F0" app:keyLabel="🇩🇰" />
        <Key app:codes="0x1F1EE,0x1F1EA" app:keyLabel="🇮🇪" />
        <Key app:codes="0x1F1F5,0x1F1ED" app:keyLabel="🇵🇭" />
        <Key app:codes="0x1F1F2,0x1F1E6" app:keyLabel="🇲🇦" />
