        <Key app:codes="0x1F1F7,0x1F1FA" app:keyLabel="🇷🇺" />
    </Row>
    <Row>
        <Key app:codes="0x1F1EF,0x1F1F5" app:keyLabel="🇯🇵" />
        <Key app:codes="0x1F1E8,0x1F1F3" app:keyLabel="🇨🇳" />
        <Key app:codes="0x1F1EE,0x1F1F3" app:keyLabel="🇮🇳" />
        <Key app:codes="0x1F1F5,0x1F1F9" app:keyLabel="🇵🇹" />
        <Key app:codes="0x1F1F0,0x1F1F7" app:keyLabel="🇰🇷" />
        <Key app:codes="0x1F1E7,0x1F1F7" app:keyLabel="🇧🇷" />
        <Key app:codes="0x1F1F2,0x1F1FD" app:keyLabel="🇲🇽" />
        <Key app:codes="0x1F1E6,0x1F1F7" app:keyLabel="🇦🇷" />
        <Key app:codes="0x1F1F3,0x1F1F1" app:keyLabel="🇳🇱" />
        <Key app:codes="0x1F1F8,0x1F1EA" app:keyLabel="🇸🇪" />
        <Key app:codes="0x1F1F3,0x1F1F4" app:keyLabel="🇳🇴" />
        <Key app:codes="0x1F1F9,0x1F1F7" app:keyLabel="🇹🇷" />
        <Key app:codes="0x1F1EC,0x1F1F7" app:keyLabel="🇬🇷" />
        <Key app:codes="0x1F1F8,0x1F1E6" app:keyLabel="🇸🇦" />
